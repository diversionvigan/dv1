# ========================================================
# Hostinger VPS & Docker Environment Variables
# ========================================================

# Port to expose on your Hostinger VPS (default: 3000)
HOST_PORT=3000

# Container Runtime Environment
NODE_ENV=production
PORT=3000

# Your Domain or VPS Public IP Address (e.g. https://yourdomain.com or http://123.45.67.89:3000)
APP_URL=http://localhost:3000

# Optional: Google Gemini API Key (if using AI features)
GEMINI_API_KEY=
